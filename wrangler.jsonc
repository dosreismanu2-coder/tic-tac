{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tic-tac",
  "main": "./worker.js",
  "compatibility_date": "2026-09-19",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" },
      { "name": "TAGS", "class_name": "TagRegistry" }
    ]
  },
  "exports": {
    "GameRoom": { "type": "durable-object", "storage": "sqlite" },
    "TagRegistry": { "type": "durable-object", "storage": "sqlite" }
  }
}
